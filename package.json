{
  "name": "nook-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A personal Windows launcher and web toolkit",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "electron-vite preview",
    "package:win": "npm run typecheck && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "pinyin-pro": "^3.29.4",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "@types/node": "^24.5.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "dev.nook.launcher",
    "productName": "Nook",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "Nook-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
