<Window x:Class="WebTools.NativeHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebTools Native Launcher"
        Width="850"
        Height="128"
        MinWidth="850"
        MaxWidth="850"
        MinHeight="128"
        MaxHeight="550"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Noto Sans SC"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        Activated="Window_Activated">
    <Window.Resources>
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="51" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ResultBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResultBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ResultBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BrandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="打开 WebTools 管理界面" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BrandBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BrandBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LauncherShortcutButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ShortcutBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ShortcutBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="ShortcutBorder" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionToggleStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SectionToggleBorder" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SectionToggleBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExpandButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LauncherScrollbarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Margin="2,0" Background="{DynamicResource QuietBrush}" CornerRadius="4" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border x:Name="DragSurface" Grid.Row="0" Background="Transparent" Cursor="SizeAll"
                ToolTip="Drag the launcher" Focusable="False"
                PreviewMouseLeftButtonDown="DragSurface_PreviewMouseLeftButtonDown"
                PreviewMouseMove="LauncherDragSurface_PreviewMouseMove"
                PreviewMouseLeftButtonUp="LauncherDragSurface_PreviewMouseLeftButtonUp" />

        <Border x:Name="LauncherPanel" Grid.Row="1" Margin="0,4,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="SearchBar" Grid.Row="0" Margin="18,0,13,0" Background="{DynamicResource SurfaceBrush}"
                      Cursor="SizeAll"
                      PreviewMouseLeftButtonDown="SearchBar_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="LauncherDragSurface_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="LauncherDragSurface_PreviewMouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⌕" FontSize="25" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="SizeAll" />
                    <Grid Grid.Column="1" Margin="13,0,8,0">
                        <TextBox x:Name="QueryBox" Background="Transparent" BorderThickness="0"
                                 Cursor="IBeam"
                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                 SelectionBrush="{DynamicResource AccentSoftBrush}" FontSize="19"
                                 VerticalContentAlignment="Center" TextChanged="QueryBox_TextChanged"
                                 GotKeyboardFocus="QueryBox_GotKeyboardFocus" />
                        <TextBlock x:Name="QueryPlaceholder" Text="搜索应用，输入 ? 搜索网页"
                                   Foreground="{DynamicResource QuietBrush}" FontSize="19"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <Button x:Name="BrandButton" Grid.Column="2" Style="{StaticResource BrandButtonStyle}"
                            Click="BrandButton_Click" AutomationProperties.Name="打开 WebTools 管理界面">
                        <Grid>
                            <Image x:Name="BrandImage" Width="30" Height="30" Stretch="Uniform" />
                            <TextBlock x:Name="BrandFallback" Text="W" Foreground="White" FontSize="20"
                                       FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>

                <Border x:Name="ShortcutPanel" Grid.Row="1" Visibility="Collapsed" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceBrush}">
                  <StackPanel Margin="13,9,13,12">
                    <Grid Height="18" Margin="0,0,0,5">
                        <TextBlock Text="收藏网址" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="WebsiteSectionToggle" HorizontalAlignment="Right" Style="{StaticResource SectionToggleStyle}"
                                IsEnabled="False" Content="展开 ↓" Click="WebsiteSectionToggle_Click" />
                    </Grid>
                    <ScrollViewer x:Name="WebsiteScroll" Height="60" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource LauncherScrollbarStyle}" />
                        </ScrollViewer.Resources>
                        <WrapPanel x:Name="WebsiteShortcuts" />
                    </ScrollViewer>
                    <Grid Height="18" Margin="0,10,0,5">
                        <TextBlock Text="插件" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="PluginSectionToggle" HorizontalAlignment="Right" Style="{StaticResource SectionToggleStyle}" IsEnabled="False" Content="展开 ↓" Click="PluginSectionToggle_Click" />
                    </Grid>
                    <ScrollViewer x:Name="PluginScroll" Height="60" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource LauncherScrollbarStyle}" /></ScrollViewer.Resources>
                        <WrapPanel x:Name="PluginShortcuts" />
                    </ScrollViewer>
                  </StackPanel>
                </Border>

                <ListBox x:Name="ResultsList" Grid.Row="1" Margin="0,0,4,0" Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextBrush}" BorderThickness="0" Visibility="Collapsed"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource ResultItemStyle}"
                         SelectionChanged="ResultsList_SelectionChanged"
                         PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource LauncherScrollbarStyle}" />
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                        Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding MatchLabel}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="8,0" />
                                <TextBlock Grid.Column="3" Text="↵" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="15">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="StatusText" Grid.Row="1" Visibility="Collapsed"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Top" Margin="18,12,18,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,2,0,0">
            <StackPanel x:Name="FooterHints" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="↑↓ 选择" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                <TextBlock Text="   Enter 打开   Esc 关闭" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="↗ WebTools" Foreground="{DynamicResource MutedBrush}" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="ExpandButton" Style="{StaticResource ExpandButtonStyle}"
                        Click="ExpandButton_Click">展开 ↓</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
