<Window x:Class="WebTools.NativeHost.SuperPanel.SuperPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebTools Super Panel" SizeToContent="Manual" Opacity="0" Focusable="False" ShowActivated="False"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" Language="zh-CN" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeChanged="Panel_SizeChanged"
        ContextMenuOpening="Panel_ContextMenuOpening" ContextMenuClosing="Panel_ContextMenuClosing">
  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#18191b"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="#202124"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2c2d30"/>
    <SolidColorBrush x:Key="TextBrush" Color="#f4f4f5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#a1a1aa"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#e4e4e7"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#242528"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#2b2c30"/>
    <Style TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Selection" Background="Transparent" CornerRadius="8"><ContentPresenter/></Border>
          <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="FeatureIcon" TargetType="Border">
      <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    </Style>
    <Style TargetType="MenuItem"><Setter Property="Focusable" Value="False"/></Style>
    <ContextMenu x:Key="FeatureMenu" x:Shared="False" Focusable="False" Opened="FeatureMenu_Opened" Closed="FeatureMenu_Closed" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="{Binding PinLabel}" Click="Pin_Click"/>
      <MenuItem Header="向前移动" IsEnabled="{Binding Pinned}" Click="MoveUp_Click"/>
      <MenuItem Header="向后移动" IsEnabled="{Binding Pinned}" Click="MoveDown_Click"/>
    </ContextMenu>
    <DataTemplate x:Key="FeatureTile">
      <Button Tag="{Binding}" Click="Activate_Click" Width="{DynamicResource ShortcutTileSide}" Height="{DynamicResource ShortcutTileSide}"
              Padding="6,5" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
              ToolTip="{Binding FullTitle}" AutomationProperties.Name="{Binding Title}" ContextMenu="{StaticResource FeatureMenu}">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
          <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers>
        </Style></Button.Style>
        <StackPanel Width="{DynamicResource ShortcutContentWidth}">
          <Border Style="{StaticResource FeatureIcon}" HorizontalAlignment="Center"
                  Loaded="FeatureIcon_Loaded" Unloaded="FeatureIcon_Unloaded" DataContextChanged="FeatureIcon_Changed" IsVisibleChanged="FeatureIcon_Changed"><Grid>
            <TextBlock Text="{Binding FallbackGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Image Source="{Binding Icon}" Stretch="Uniform" Width="24" Height="24"/>
          </Grid></Border>
          <TextBlock Text="{Binding Title}" FontSize="11" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                     MaxHeight="28" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
        </StackPanel>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="FeatureAction">
      <Button Tag="{Binding}" PreviewMouseDown="Activate_PreviewMouseDown" Click="Activate_Click" Padding="6,4" HorizontalContentAlignment="Stretch"
              ToolTip="{Binding IdentityTitle}" AutomationProperties.Name="{Binding Title}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource FeatureIcon}"
                  Loaded="FeatureIcon_Loaded" Unloaded="FeatureIcon_Unloaded" DataContextChanged="FeatureIcon_Changed" IsVisibleChanged="FeatureIcon_Changed"><Grid>
            <TextBlock Text="{Binding FallbackGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Image Source="{Binding Icon}" Stretch="Uniform" Width="24" Height="24"/>
          </Grid></Border>
          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Border x:Name="PanelRoot" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
    <StackPanel>
      <DockPanel x:Name="PanelHeader" Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Width="30" Height="30" Click="Search_Click" ToolTip="打开 WebTools 搜索" AutomationProperties.Name="打开 Launcher 搜索"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/></Button>
        <TextBlock x:Name="PanelTitle" Text="WebTools" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
      <StackPanel x:Name="ContextSurface" Visibility="Collapsed">
        <Border x:Name="TextContextRoot" Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="TextPreview" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="54" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TextCount" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="DirectoryContextRoot" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,8" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="所选文件夹" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,6"/>
            <ItemsControl x:Name="DirectoryNames">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="4,3"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="DirectoryOverflow" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="30,4,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="ExplorerContextRoot" Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="正在浏览的目录 · 未选择项目" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock x:Name="ExplorerName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,3"/>
              <TextBlock x:Name="ExplorerPath" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border x:Name="QuickResultConsentSurface" Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="确认发送至当前共享 AI 服务？" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="QuickResultConsentSource" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,6"/>
            <ScrollViewer x:Name="QuickResultConsentScroll" MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <TextBlock x:Name="QuickResultConsentPreview" FontSize="11" TextWrapping="Wrap"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
              <Button Content="取消" Click="QuickResultConsentCancel_Click" Padding="10,5" Margin="0,0,6,0"/>
              <Button Content="确认发送" Click="QuickResultConsentApprove_Click" Background="{DynamicResource SelectedBrush}" Padding="10,5"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border x:Name="QuickResultSurface" Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
          <StackPanel>
            <DockPanel Margin="0,0,0,6">
              <Button x:Name="TranslationPreviewCancel" DockPanel.Dock="Right" Content="取消" Padding="6,2" FontSize="11" Visibility="Collapsed" Click="TranslationPreviewCancel_Click"/>
              <TextBlock x:Name="QuickResultSource" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer x:Name="QuickResultScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220" Focusable="False">
              <TextBlock x:Name="QuickResultBody" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/>
            </ScrollViewer>
          </StackPanel>
        </Border>
        <TextBlock x:Name="ContextActionsLabel" Text="可用操作" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,4" Visibility="Collapsed"/>
        <Grid x:Name="ActionSurface" MaxHeight="240">
          <ListBox x:Name="ActionList" SelectionChanged="Selection_Changed" ItemTemplate="{StaticResource FeatureAction}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                   VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          </ListBox>
          <TextBlock x:Name="EmptyText" Text="暂无适配功能" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="4,10,4,12"/>
        </Grid>
        <Border x:Name="FileContextRoot" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="4,10,4,0" Margin="0,8,0,0" Visibility="Collapsed">
          <StackPanel>
            <DockPanel Margin="0,0,0,5">
              <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/>
              <TextBlock x:Name="FilesCount" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <ItemsControl x:Name="FileNames">
              <ItemsControl.ItemTemplate><DataTemplate>
                <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="FilesOverflow" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <TextBlock x:Name="TriggerNotice" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" Visibility="Collapsed"/>
      <Grid x:Name="BoardSurface" Visibility="Collapsed">
        <Grid x:Name="BoardGrid">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
          <ListBox x:Name="BoardList" ItemTemplate="{StaticResource FeatureTile}" AllowDrop="True"
                   KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                   PreviewMouseLeftButtonDown="Board_PointerDown" PreviewMouseMove="Board_PointerMove" Drop="Board_Drop">
            <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="3" Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          </ListBox>
          <TextBlock x:Name="BoardEmpty" Text="添加常用功能到快捷面板" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <DockPanel Grid.Row="1" LastChildFill="False">
            <Button x:Name="AddShortcut" Content="＋ 添加" Click="AddShortcut_Click" Padding="8,4" ToolTip="添加快捷功能"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="PreviousPage" Content="‹" Click="PreviousPage_Click" AllowDrop="True" DragEnter="Page_DragEnter" Width="28" Padding="4" AutomationProperties.Name="上一页"/>
              <TextBlock x:Name="PageLabel" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="6,0"/>
              <Button x:Name="NextPage" Content="›" Click="NextPage_Click" AllowDrop="True" DragEnter="Page_DragEnter" Width="28" Padding="4" AutomationProperties.Name="下一页"/>
            </StackPanel>
          </DockPanel>
        </Grid>
        <Grid x:Name="BoardChooser" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel><Button Content="返回" DockPanel.Dock="Right" Click="CancelChoice_Click" Padding="8,4"/><TextBlock Text="添加快捷功能" FontSize="12" VerticalAlignment="Center"/></DockPanel>
          <ListBox x:Name="ChoiceList" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate><DataTemplate>
              <Button Tag="{Binding}" Click="Choose_Click" HorizontalContentAlignment="Stretch" ToolTip="{Binding Title}">
                <StackPanel><TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
              </Button>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="ChoiceEmpty" Grid.Row="1" Text="暂无可添加的通用功能" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="8,16" IsHitTestVisible="False"/>
        </Grid>
      </Grid>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,8,2,0" Visibility="Collapsed"/>
    </StackPanel>
  </Border>
</Window>
