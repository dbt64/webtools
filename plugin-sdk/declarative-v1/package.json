{
  "name": "@webtools/plugin-sdk",
  "version": "1.1.0",
  "private": true,
  "description": "Local authoring SDK and validator for WebTools declarative plugins",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20.19" },
  "bin": { "webtools-plugin": "bin/webtools-plugin.mjs" },
  "types": "types.d.ts",
  "exports": {
    ".": { "types": "./types.d.ts", "import": "./index.mjs" },
    "./manifest.schema.json": "./manifest.schema.json",
    "./package.json": "./package.json"
  },
  "files": ["bin", "src", "runtime", "types.d.ts", "manifest.schema.json", "index.mjs", "README.md"],
  "dependencies": { "yauzl": "3.4.0" }
}
